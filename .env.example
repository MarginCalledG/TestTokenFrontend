# ---------------------------------------------------------------------------
# Network. Defaults to Robinhood Chain MAINNET (4663).
# ---------------------------------------------------------------------------
VITE_CHAIN=mainnet          # "mainnet" | "testnet"

# ---------------------------------------------------------------------------
# Contract addresses. On mainnet every blank value falls back to the live test
# deployment in src/config/addresses.ts (Higher 0x3531…bf05). Set a value to
# point the app at a different deployment — e.g. the real launch.
# ---------------------------------------------------------------------------
VITE_HIGHER_ADDRESS=
VITE_CAYMAN_ADDRESS=
VITE_IRSAGENT_ADDRESS=
VITE_TWAPORACLE_ADDRESS=
VITE_SEED_ADDRESS=
VITE_PAIR_ADDRESS=
# Uniswap V2 on RH mainnet, SPY and USDG (Paxos) — normally leave blank.
VITE_ROUTER_ADDRESS=
VITE_SPY_ADDRESS=
VITE_USDG_ADDRESS=

# Demo mode fills every screen with invented data. Never true on a real build.
VITE_DEMO_MODE=false
